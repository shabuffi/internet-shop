# ─── PostgreSQL ───────────────────────────────────────
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE
POSTGRES_DB=shop_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Backend ──────────────────────────────────────────
SECRET_KEY=GENERATE_WITH: python3 -c "import secrets; print(secrets.token_hex(32))"
DEBUG=false
ALLOWED_ORIGINS=["http://YOUR_SERVER_IP"]

# ─── Уведомления о заказах ────────────────────────────
# ВКонтакте: ключ доступа сообщества + ваш peer_id. Если заданы здесь —
# владельцу НЕ нужно вводить их в админке (поля скрываются, остаётся «✓ подключён»).
# Оставьте пустыми, если хотите настраивать ВК через админку.
VK_GROUP_TOKEN=
VK_PEER_ID=

# Email-уведомления (SMTP) обычно настраиваются в админке (Настройки → SMTP),
# но при желании можно задать и тут как фолбэк: SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD.

# Примечание: интеграция с МойСклад идёт ТОЛЬКО через обмен CommerceML —
# логин/пароль аккаунта МойСклад НЕ нужны (пара логин/пароль обмена задаётся в админке).
